{
  "name": "agent-marketplace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22 <23" },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/tests/*/*.test.js",
    "test:platform": "npm run build && node --test dist/tests/platform/*.test.js",
    "test:agents": "npm run build && node --test dist/tests/agents/*.test.js",
    "test:sourcing": "npm run build && node --test dist/tests/sourcing/*.test.js",
    "test:e2e": "npm run build && node --test dist/tests/integration/*.test.js",
    "check": "npm run typecheck && npm test",
    "payments:operator": "npm run build --silent && node --env-file-if-exists=.env.local --env-file-if-exists=.dev.vars dist/src/payments/operator-cli.js"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "pg": "8.23.1",
    "ws": "8.22.0"
  }
}
